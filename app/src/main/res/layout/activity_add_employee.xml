<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffeeCream"
    android:padding="16dp"
    tools:context=".activity.AddEmployeeActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/employeeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/header_add_employee_view_employee"
        android:textColor="@color/coffeeDark"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- EditText style shared -->
    <!-- Full Name -->
    <EditText
        android:id="@+id/edtFullName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/employees_fullname_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="50"
        app:layout_constraintTop_toBottomOf="@id/employeeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Username -->
    <EditText
        android:id="@+id/edtUserName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/employees_username_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="50"
        app:layout_constraintTop_toBottomOf="@id/edtFullName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Email -->
    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/employees_email_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="50"
        app:layout_constraintTop_toBottomOf="@id/edtUserName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Phone Number -->
    <EditText
        android:id="@+id/edtPhoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/employees_phonenumber_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="15"
        app:layout_constraintTop_toBottomOf="@id/edtEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Password -->
    <EditText
        android:id="@+id/edtPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/employees_password_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:inputType="textPassword"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="50"
        app:layout_constraintTop_toBottomOf="@id/edtPhoneNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Confirm Password -->
    <EditText
        android:id="@+id/edtConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/employees_confirmpassword_add_employee"
        android:padding="12dp"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeTextDark"
        android:inputType="textPassword"
        android:backgroundTint="@color/coffeeGray"
        android:maxLength="50"
        app:layout_constraintTop_toBottomOf="@id/edtPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Role Spinner -->
    <Spinner
        android:id="@+id/spPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:backgroundTint="@color/coffeeLightBrown"
        app:layout_constraintTop_toBottomOf="@id/edtConfirmPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveEmployee"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        android:text="@string/save_employee_view_employee"
        android:textColor="@color/coffeeCream"
        android:backgroundTint="@color/coffeeBrown"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/spPosition"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
