<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/coffeeCream"
    tools:context=".activity.EditCategoryActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Edit Category"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/coffeeBrown"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Label -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Category Name"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/coffeeTextDark"
        app:layout_constraintTop_toBottomOf="@id/textView1"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Input -->
    <EditText
        android:id="@+id/edtCategoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Enter category name"
        android:padding="16dp"
        android:backgroundTint="@color/coffeeGray"
        android:textColor="@color/coffeeTextDark"
        android:textColorHint="@color/coffeeGray"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/cancelButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Cancel"
        android:textStyle="bold"
        android:textColor="@color/coffeeTextDark"
        android:backgroundTint="@color/coffeeLightBrown"
        app:layout_constraintTop_toBottomOf="@id/edtCategoryName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSaveCategory"
        app:layout_constraintWidth_percent="0.45" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Save"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/coffeeBrown"
        app:layout_constraintTop_toBottomOf="@id/edtCategoryName"
        app:layout_constraintStart_toEndOf="@id/cancelButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.45" />

</androidx.constraintlayout.widget.ConstraintLayout>
