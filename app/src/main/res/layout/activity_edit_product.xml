<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f4f1"
    android:padding="16dp"
    tools:context=".activity.EditProductActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/productTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Product"
        android:textSize="32sp"
        android:textColor="#47372f"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Product Name -->
    <EditText
        android:id="@+id/edtProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Product Name"
        android:backgroundTint="#cfcfcf"
        android:textColor="#131313"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/productTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Recipe -->
    <EditText
        android:id="@+id/edtProductRecipe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Product Recipe"
        android:backgroundTint="#cfcfcf"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:minLines="3"
        app:layout_constraintTop_toBottomOf="@id/edtProductName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Product Price -->
    <EditText
        android:id="@+id/edtProductPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Product Price"
        android:inputType="numberDecimal"
        android:backgroundTint="#cfcfcf"
        app:layout_constraintTop_toBottomOf="@id/edtProductRecipe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Category Spinner -->
    <Spinner
        android:id="@+id/spCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/edtProductPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stock Quantity -->
    <EditText
        android:id="@+id/edtStockQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Stock Quantity"
        android:inputType="number"
        android:backgroundTint="#cfcfcf"
        app:layout_constraintTop_toBottomOf="@id/spCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Active Switch -->
    <Switch
        android:id="@+id/swActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Active"
        android:textColor="#47372f"
        app:layout_constraintTop_toBottomOf="@id/edtStockQuantity"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Image Preview -->
    <ImageView
        android:id="@+id/ivProductImage"
        android:layout_width="200dp"
        android:layout_height="160dp"
        android:layout_marginTop="20dp"
        android:contentDescription="Product Image"
        android:onClick="openFileChooserEdit"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toBottomOf="@id/swActive"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- File Name -->
    <TextView
        android:id="@+id/txtFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="No image selected"
        android:textColor="#6c513d"
        android:textSize="14sp"
        android:textStyle="italic"
        app:layout_constraintTop_toTopOf="@+id/ivProductImage"
        app:layout_constraintStart_toEndOf="@id/ivProductImage"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Image URL input -->
    <EditText
        android:id="@+id/edtImageUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Image URL"
        android:layout_marginTop="8dp"
        android:inputType="textUri"
        app:layout_constraintTop_toBottomOf="@id/ivProductImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preview URL image button -->
    <Button
        android:id="@+id/btnPreviewUrlImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preview URL Image"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/edtImageUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveProduct"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="Save Product"
        android:backgroundTint="#a2795d"
        android:textColor="#ffffff"
        app:layout_constraintTop_toBottomOf="@id/btnPreviewUrlImage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>